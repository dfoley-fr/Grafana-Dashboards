  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mysql", "rds", "mysqld_exporter"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "name": "datasource",
        "query": "grafana-amazonprometheus-datasource",
        "refresh": 1,
