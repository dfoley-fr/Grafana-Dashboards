      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "grafana-amazonprometheus-datasource", "uid": "${datasource}" },
        "definition": "label_values(mysql_up, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Job",
        "multi": false,
        "name": "job",
        "query": { "query": "label_values(mysql_up, job)", "refId": "StandardVariableQuery" },
