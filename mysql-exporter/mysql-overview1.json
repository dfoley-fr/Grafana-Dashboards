      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "grafana-amazonprometheus-datasource", "uid": "${datasource}" },
        "definition": "label_values(mysql_up{job=~\"$job\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "RDS Instance",
        "multi": false,
        "name": "instance",
        "query": { "query": "label_values(mysql_up{job=~\"$job\"}, instance)", "refId": "StandardVariableQuery" },
